<div class="grid grid-cols-2 gap-4 lg:grid-cols-4 xl:grid-cols-4">

  <!-- Total Cash -->

  <div class="p-5 bg-blue-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-blue-700 uppercase">
      Total Cash
    </p>

    <p class="mt-3 text-xs font-bold text-blue-900">
      UGX <%= number_with_delimiter(@total_cash) %>
    </p>

    <p class="mt-1 text-xs text-blue-700">
      Across all accounts
    </p>

  </div>

  <!-- Deposits -->

  <div class="p-5 bg-green-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-green-700 uppercase">
      Deposits
    </p>

    <p class="mt-3 text-xs font-bold text-green-900">
      UGX <%= number_with_delimiter(@total_deposits) %>
    </p>

    <p class="mt-1 text-xs text-green-700">
      Money received
    </p>

  </div>

  <!-- Withdrawals -->

  <div class="p-5 bg-red-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-red-700 uppercase">
      Withdrawals
    </p>

    <p class="mt-3 text-xs font-bold text-red-900">
      UGX <%= number_with_delimiter(@total_withdrawals) %>
    </p>

    <p class="mt-1 text-xs text-red-700">
      Money withdrawn
    </p>

  </div>

  <!-- Transfers -->

  <div class="p-5 bg-purple-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-purple-700 uppercase">
      Transfers
    </p>

    <p class="mt-3 text-xs font-bold text-purple-900">
      UGX <%= number_with_delimiter(@total_transfers) %>
    </p>

    <p class="mt-1 text-xs text-purple-700">
      Between accounts
    </p>

  </div>

  <!-- Supplier Payments -->

  <div class="p-5 bg-orange-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-orange-700 uppercase">
      Supplier Payments
    </p>

    <p class="mt-3 text-xs font-bold text-orange-900">
      UGX <%= number_with_delimiter(@supplier_payments) %>
    </p>

    <p class="mt-1 text-xs text-orange-700">
      Vendor payments
    </p>

  </div>

  <!-- Employee Payments -->

  <div class="p-5 bg-yellow-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-yellow-700 uppercase">
      Employee Payments
    </p>

    <p class="mt-3 text-xs font-bold text-yellow-900">
      UGX <%= number_with_delimiter(@employee_payments) %>
    </p>

    <p class="mt-1 text-xs text-yellow-700">
      Salaries & advances
    </p>

  </div>

  <!-- Bank Accounts -->

  <div class="p-5 bg-indigo-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-indigo-700 uppercase">
      Bank Accounts
    </p>

    <p class="mt-3 text-xs font-bold text-indigo-900">
      <%= @bank_account_count %>
    </p>

    <p class="mt-1 text-xs text-indigo-700">
      Active accounts
    </p>

  </div>

  <!-- Net Position -->

  <div class="p-5 bg-gray-100 shadow rounded-xl">

    <p class="text-xs font-semibold tracking-wide text-gray-700 uppercase">
      Net Position
    </p>

    <p class="mt-3 text-xs font-bold text-gray-900">
      UGX <%= number_with_delimiter(@net_cash_position) %>
    </p>

    <p class="mt-1 text-xs text-gray-600">
      Available cash
    </p>

  </div>

</div>