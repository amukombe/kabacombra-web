<div class="bg-white border border-gray-200 shadow-sm rounded-xl dark:bg-gray-800 dark:border-gray-700">

  <!-- Header -->

  <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700">

    <div>

      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
        Recent Deposits
      </h2>

      <p class="text-sm text-gray-500">
        Latest money deposited into bank accounts
      </p>

    </div>

    <%= link_to "View All",
        bank_deposits_path,
        class: "text-sm font-medium text-blue-600 hover:text-blue-800" %>

  </div>

  <% if @recent_deposits.any? %>

    <div class="overflow-x-auto">

      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">

        <thead class="bg-gray-50 dark:bg-gray-900">

          <tr>

            <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
              Date
            </th>

            <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
              Account
            </th>

            <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
              Reference
            </th>

            <th class="px-4 py-3 text-xs font-semibold text-right uppercase">
              Amount
            </th>

          </tr>

        </thead>

        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">

          <% @recent_deposits.each do |deposit| %>

            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">

              <td class="px-4 py-3 whitespace-nowrap">
                <%= deposit.deposit_date.strftime("%d %b %Y") %>
              </td>

              <td class="px-4 py-3">

                <div class="font-medium text-gray-900 dark:text-white">
                  <%= deposit.bank_account.account_name %>
                </div>

                <div class="text-xs text-gray-500">
                  <%= deposit.bank_account.account_number %>
                </div>

              </td>

              <td class="px-4 py-3">

                <%= deposit.transaction_reference.presence || "-" %>

              </td>

              <td class="px-4 py-3 font-semibold text-right text-green-600">

                UGX
                <%= number_with_delimiter(deposit.amount) %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% else %>

    <div class="p-10 text-center">

      <svg class="w-10 h-10 mx-auto text-gray-300"
           fill="none"
           stroke="currentColor"
           viewBox="0 0 24 24">

        <path stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v8m4-4H8"/>

      </svg>

      <h3 class="mt-3 text-lg font-semibold text-gray-700 dark:text-gray-300">
        No Deposits Found
      </h3>

      <p class="mt-1 text-sm text-gray-500">
        Deposits will appear here once they are recorded.
      </p>

      <div class="mt-5">

        <%= link_to "Record Deposit",
            new_bank_deposit_path,
            class: "px-4 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700" %>

      </div>

    </div>

  <% end %>

</div>