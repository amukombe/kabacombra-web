<%= render "/shared/finance_nav" %>

<div class="min-h-screen px-4 py-4 bg-gray-50 dark:bg-gray-900">

  <div class="mb-8">

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
      Banking Dashboard
    </h1>

    <p class="text-gray-500">
      Cash management and banking overview
    </p>

  </div>

  <%= render "summary_cards" %>

  <div class="grid grid-cols-1 gap-6 mt-8 xl:grid-cols-3">

      <div class="xl:col-span-1">

          <%= render "accounts" %>

      </div>

      <div class="xl:col-span-2">

          <%= render "recent_transactions" %>

      </div>

  </div>

  <div class="grid grid-cols-1 gap-6 mt-8 lg:grid-cols-2">

      <%= render "recent_deposits" %>

      <%= render "recent_withdrawals" %>

  </div>

</div>