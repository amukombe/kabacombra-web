<%= render "/shared/purchases_nav" %>

<div class="px-4 pt-4 bg-white dark:bg-gray-900">

  <!-- Header -->
  <div class="grid items-center w-full grid-cols-2 gap-4 mb-4">
    <div>
      <h1 class="text-lg font-semibold text-gray-800 dark:text-white">
        Vendor Adjustments
      </h1>

      <p class="text-sm text-gray-500">
        Supplier debit and credit adjustments
      </p>
    </div>

    <div class="text-right">
      <%= link_to "New Adjustment",
          new_vendor_adjustiment_path,
          data: { turbo: false },
          class: "px-5 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 gap-4 mb-6 md:grid-cols-3">

    <div class="p-5 bg-blue-100 rounded-lg">
      <p class="text-xs font-semibold tracking-wide text-blue-700 uppercase">
        Total Debits
      </p>

      <p class="mt-2 text-2xl font-bold text-blue-900">
        UGX <%= number_with_delimiter(@total_debits) %>
      </p>
    </div>

    <div class="p-5 bg-green-100 rounded-lg">
      <p class="text-xs font-semibold tracking-wide text-green-700 uppercase">
        Total Credits
      </p>

      <p class="mt-2 text-2xl font-bold text-green-900">
        UGX <%= number_with_delimiter(@total_credits) %>
      </p>
    </div>

    <div class="p-5 bg-purple-100 rounded-lg">
      <p class="text-xs font-semibold tracking-wide text-purple-700 uppercase">
        Net Adjustments
      </p>

      <p class="mt-2 text-2xl font-bold text-purple-900">
        UGX <%= number_with_delimiter(@net_adjustments) %>
      </p>
    </div>

  </div>

  <!-- Purchase Type Summary Cards -->
    <div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2 lg:grid-cols-4">

      <% @purchase_type_totals.each do |purchase_type, total| %>

        <div class="p-5 bg-white border border-gray-200 rounded-lg shadow-sm">

          <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">
            <%= purchase_type.name %>
          </p>

          <p class="mt-2 text-sm font-bold text-gray-900">
            UGX <%= number_with_delimiter(total) %>
          </p>

          <p class="mt-1 text-xs text-gray-500">
            Total adjustments
          </p>

        </div>

      <% end %>

    </div>
  <!-- Search -->
  <%= form_with url: vendor_adjustiments_path,
                method: :get,
                local: true,
                class: "flex flex-wrap items-end gap-3 mb-6" do %>

      <div>
        <label class="block mb-1 text-xs font-medium">
          Search
        </label>

        <%= text_field_tag :query,
              params[:query],
              placeholder: "Journal / Reference...",
              class: "w-64 border rounded-lg p-2.5" %>
      </div>

      <div>
        <label class="block mb-1 text-xs">
          From
        </label>

        <%= date_field_tag :start_date,
              params[:start_date],
              class: "border rounded-lg p-2.5" %>
      </div>

      <div>
        <label class="block mb-1 text-xs">
          To
        </label>

        <%= date_field_tag :end_date,
              params[:end_date],
              class: "border rounded-lg p-2.5" %>
      </div>

      <div>
        <%= submit_tag "Filter",
              class: "px-5 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>
      </div>

  <% end %>

  <!-- Table -->
  <div class="overflow-hidden bg-white rounded-lg shadow">

    <table class="min-w-full divide-y divide-gray-200">

      <thead class="bg-gray-50">

        <tr>

          <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
            Journal
          </th>

          <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
            Date
          </th>

          <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
            Category
          </th>

          <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
            Type
          </th>

          <th class="px-4 py-3 text-xs font-semibold text-right uppercase">
            Amount
          </th>

          <th class="px-4 py-3 text-xs font-semibold text-left uppercase">
            Description
          </th>

          <th class="px-4 py-3 text-xs font-semibold text-center uppercase">
            Action
          </th>

        </tr>

      </thead>

      <tbody class="divide-y divide-gray-200">

      <% @vendor_adjustiments.each do |adjustment| %>

        <tr class="hover:bg-gray-50">

          <td class="px-4 py-3">

            <div class="font-medium">
              <%= adjustment.journal_no %>
            </div>

            <div class="text-xs text-gray-500">
              <%= adjustment.ref_no %>
            </div>

          </td>

          <td class="px-4 py-3">
            <%= adjustment.adjustment_date.strftime("%d %b %Y") %>
          </td>

          <td class="px-4 py-3">

            <% color =
              case adjustment.adjustment_category
              when "payment_incentive"
                "bg-green-100 text-green-800"
              when "warehouse_incentive"
                "bg-blue-100 text-blue-800"
              when "rebate"
                "bg-purple-100 text-purple-800"
              else
                "bg-gray-100 text-gray-700"
              end %>

            <span class="px-3 py-1 text-xs rounded-full <%= color %>">
              <%= adjustment.adjustment_category.titleize %>
            </span>

          </td>

          <td class="px-4 py-3">

            <% if adjustment.credit? %>

              <span class="px-3 py-1 text-xs text-green-700 bg-green-100 rounded-full">
                Credit
              </span>

            <% else %>

              <span class="px-3 py-1 text-xs text-red-700 bg-red-100 rounded-full">
                Debit
              </span>

            <% end %>

          </td>

          <td class="px-4 py-3 font-semibold text-right">

            UGX
            <%= number_with_delimiter(adjustment.amount) %>

          </td>

          <td class="px-4 py-3">

            <%= adjustment.description %>

          </td>

          <td class="px-4 py-3 text-center">

            <%= link_to "View",
                vendor_adjustiment_path(adjustment),
                class: "text-blue-600 hover:underline" %>

          </td>

        </tr>

      <% end %>

      </tbody>

    </table>

  </div>

  <div class="mt-6">
    <%= paginate @vendor_adjustiments %>
  </div>

</div>