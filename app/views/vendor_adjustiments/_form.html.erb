<%= form_with model: @vendor_adjustiment,
              local: true,
              data: { turbo: false },
              class: "space-y-6" do |form| %>

<% if @vendor_adjustiment.errors.any? %>

<div class="p-4 border border-red-300 rounded-lg bg-red-50">

    <h2 class="mb-2 font-semibold text-red-700">
      Please correct the following errors
    </h2>

    <ul class="ml-5 text-sm text-red-600 list-disc">

      <% @vendor_adjustiment.errors.full_messages.each do |message| %>

        <li><%= message %></li>

      <% end %>

    </ul>

</div>

<% end %>

<div class="grid grid-cols-1 gap-6 md:grid-cols-2">

  <!-- Adjustment Date -->

  <div>

    <%= form.label :adjustment_date,
          class: "block mb-2 text-sm font-medium" %>

    <%= form.date_field :adjustment_date,
          class: "w-full rounded-lg border-gray-300" %>

  </div>

  <!-- Purchase Type -->

  <div>

    <%= form.label :purchase_type_id,
          class: "block mb-2 text-sm font-medium" %>

    <%= form.collection_select :purchase_type_id,
          PurchaseType.order(:name),
          :id,
          :name,
          { prompt: "Select Purchase Type" },
          class: "w-full rounded-lg border-gray-300" %>

  </div>

  <!-- Adjustment Type -->

  <div>

    <%= form.label :adjustment_type,
          class: "block mb-2 text-sm font-medium" %>

    <%= form.select :adjustment_type,
          VendorAdjustiment.adjustment_types.keys.map { |t| [t.titleize, t] },
          {},
          class: "w-full rounded-lg border-gray-300" %>

  </div>

  <!-- Amount -->

  <div>

    <%= form.label :amount,
          class: "block mb-2 text-sm font-medium" %>

    <%= form.number_field :amount,
          step: 0.01,
          class: "w-full rounded-lg border-gray-300" %>

  </div>

  <!-- Reference -->

  <div>

    <%= form.label :ref_no,
          class: "block mb-2 text-sm font-medium" %>

    <%= form.text_field :ref_no,
          class: "w-full rounded-lg border-gray-300",
          placeholder: "Reference Number" %>

  </div>

  <!-- Journal -->

  <div>

    <label class="block mb-2 text-sm font-medium">
      Journal Number
    </label>

    <input type="text"
           value="<%= @vendor_adjustiment.journal_no.presence || 'Auto Generated' %>"
           disabled
           class="w-full bg-gray-100 border-gray-300 rounded-lg">

  </div>

</div>

<!-- Description -->

<div>

  <%= form.label :description,
        class: "block mb-2 text-sm font-medium" %>

  <%= form.text_area :description,
        rows: 5,
        class: "w-full rounded-lg border-gray-300",
        placeholder: "Reason for adjustment..." %>

</div>

<div class="flex justify-end gap-3 pt-6">

  <%= link_to "Cancel",
      vendor_adjustiments_path,
      class: "px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300" %>

  <%= form.submit "Save Adjustment",
      class: "px-6 py-2 font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>

</div>

<% end %>