<div class="rounded-lg shadow-lg dark:bg-gray-800">
  <%= form_with(model: discount, data: { controller: "discount" }) do |form| %>

    <% if @discount.errors.any? %>
      <!-- keep your existing error block here -->
    <% end %>

    <div class="grid grid-cols-3 gap-4 p-4">

      <div>
        <%= form.label :name, class:"text-sm text-gray-600 dark:text-gray-400" %>
        <i class="text-red-600">*</i>
        <%= form.text_field :name, class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white" %>
      </div>

      <div>
        <%= form.label :rule_type, class:"text-sm text-gray-600 dark:text-gray-400" %>
        <i class="text-red-600">*</i>

        <%= form.select :rule_type,
          Discount.rule_types.keys.map { |x| [x.humanize, x] },
          {},
          class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white",
          data: {
            discount_target: "ruleType",
            action: "change->discount#toggleFields"
          } %>
      </div>

      <div>
        <%= form.label :discount_type, class:"text-sm text-gray-600 dark:text-gray-400" %>
        <i class="text-red-600">*</i>

        <%= form.select :discount_type,
          Discount.discount_types.keys.map { |x| [x.humanize, x] },
          { include_blank: "Select Discount Type" },
          class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white" %>
      </div>

      <div>
        <%= form.label :discount_value, class:"text-sm text-gray-600 dark:text-gray-400" %>
        <i class="text-red-600">*</i>

        <%= form.number_field :discount_value,
          step: 0.01,
          class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white" %>
      </div>

      <div data-discount-target="buyQuantityField">
        <%= form.label :buy_quantity, "Buy Quantity", class:"text-sm text-gray-600 dark:text-gray-400" %>

        <%= form.number_field :buy_quantity,
          step: 1,
          class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white" %>
      </div>

      <div data-discount-target="applyToField">
        <label class="text-sm text-gray-600 dark:text-gray-400">Apply Discount To</label>

        <div class="mt-2 space-y-2">
          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
            <%= form.radio_button :apply_to_all, true,
              data: { action: "change->discount#toggleFields" } %>
            Entire Quantity Purchased
          </label>

          <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
            <%= form.radio_button :apply_to_all, false,
              data: { action: "change->discount#toggleFields" } %>
            Specific Quantity
          </label>
        </div>
      </div>

      <div data-discount-target="discountQuantityField">
        <%= form.label :discount_quantity, "Discount Quantity", class:"text-sm text-gray-600 dark:text-gray-400" %>

        <%= form.number_field :discount_quantity,
          step: 1,
          class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:text-white" %>
      </div>

      <div class="flex items-center mt-7" data-discount-target="repeatableField">
        <%= form.check_box :repeatable,
          class:"w-5 h-5 text-blue-600 border-gray-300 rounded" %>

        <%= form.label :repeatable,
          class:"ml-2 text-sm text-gray-700 dark:text-gray-300" %>
      </div>

      <div class="flex items-center mt-7">
        <%= form.check_box :active,
          class:"w-5 h-5 text-blue-600 border-gray-300 rounded" %>

        <%= form.label :active,
          class:"ml-2 text-sm text-gray-700 dark:text-gray-300" %>
      </div>

    </div>

    <div class="flex justify-end gap-4 p-4">
      <%= form.submit "Save Discount",
        class:"bg-slate-700 text-white px-4 py-2 rounded-full hover:bg-slate-800" %>

      <%= link_to "Return",
        discounts_path,
        class:"bg-red-200 text-red-800 px-4 py-2 rounded-full hover:bg-red-300" %>
    </div>

  <% end %>
</div>