<%= render "/shared/purchases_nav" %>

<div class="px-4 pt-4 bg-white dark:bg-gray-900">

  <!-- Header -->
  <div class="grid items-center grid-cols-2 gap-4 mb-6">

    <div>
      <h1 class="text-xl font-semibold text-gray-900 dark:text-white">
        Vendor Statement
      </h1>

      <p class="mt-1 text-sm text-gray-500">
        Supplier account statement
      </p>
    </div>

    <div class="text-right">

      <%= link_to "Export PDF",
          vendor_statement_path(
            format: :pdf,
            start_date: params[:start_date],
            end_date: params[:end_date]
          ),
          class: "px-5 py-2 text-white bg-red-600 rounded-lg hover:bg-red-700" %>

    </div>

  </div>

  <!-- Filters -->

  <%= form_with url: vendor_statement_path,
                method: :get,
                local: true,
                class: "flex flex-wrap items-end gap-4 mb-8" do %>

      <div>

        <label class="block mb-1 text-xs font-medium">
          From
        </label>

        <%= date_field_tag :start_date,
              params[:start_date],
              class:"border rounded-lg p-2.5" %>

      </div>

      <div>

        <label class="block mb-1 text-xs font-medium">
          To
        </label>

        <%= date_field_tag :end_date,
              params[:end_date],
              class:"border rounded-lg p-2.5" %>

      </div>

      <div>

        <%= submit_tag "Apply Filter",
            class:"px-5 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>

      </div>

  <% end %>


<!-- Summary Cards -->

<div class="grid grid-cols-1 gap-4 mb-8 md:grid-cols-5">

  <div class="p-5 bg-gray-100 rounded-lg">
    <p class="text-xs font-medium uppercase">
      Opening Balance
    </p>

    <p class="mt-2 text-2xl font-bold">
      UGX <%= number_with_delimiter(@opening_balance || 0) %>
    </p>
  </div>

  <div class="p-5 bg-blue-100 rounded-lg">
    <p class="text-xs font-medium uppercase">
      Purchases
    </p>

    <p class="mt-2 text-2xl font-bold">
      UGX <%= number_with_delimiter(@purchase_total || 0) %>
    </p>
  </div>

  <div class="p-5 bg-green-100 rounded-lg">
    <p class="text-xs font-medium uppercase">
      Payments
    </p>

    <p class="mt-2 text-2xl font-bold">
      UGX <%= number_with_delimiter(@payment_total || 0) %>
    </p>
  </div>

  <div class="p-5 bg-yellow-100 rounded-lg">
    <p class="text-xs font-medium uppercase">
      Net Adjustments
    </p>

    <p class="mt-2 text-2xl font-bold">
      UGX <%= number_with_delimiter(@adjustments_total || 0) %>
    </p>
  </div>

  <div class="p-5 bg-purple-100 rounded-lg">
    <p class="text-xs font-medium uppercase">
      Closing Balance
    </p>

    <p class="mt-2 text-2xl font-bold">
      UGX <%= number_with_delimiter(@closing_balance || 0) %>
    </p>
  </div>

</div>

  <!-- Ledger -->

  <div class="overflow-hidden bg-white rounded-lg shadow">

    <table class="min-w-full divide-y divide-gray-200">

      <thead class="bg-gray-50">

        <tr>

          <th class="px-4 py-3 text-left">Date</th>

          <th class="px-4 py-3 text-left">
            Journal
          </th>

          <th class="px-4 py-3 text-left">
            Reference
          </th>

          <th class="px-4 py-3 text-left">
            Description
          </th>

          <th class="px-4 py-3 text-right">
            Debit
          </th>

          <th class="px-4 py-3 text-right">
            Credit
          </th>

          <th class="px-4 py-3 text-right">
            Balance
          </th>

        </tr>

      </thead>

      <tbody class="divide-y divide-gray-200">

      <% @ledger.each do |entry| %>

        <tr>

          <td class="px-4 py-3">

            <%= entry[:date].strftime("%d %b %Y") %>

          </td>

          <td class="px-4 py-3">

            <%= entry[:journal] %>

          </td>

          <td class="px-4 py-3">

            <%= entry[:reference] %>

          </td>

          <td class="px-4 py-3">

            <%= entry[:description] %>

          </td>

          <td class="px-4 py-3 text-right">

            <% if entry[:debit] > 0 %>

              UGX
              <%= number_with_delimiter(entry[:debit]) %>

            <% end %>

          </td>

          <td class="px-4 py-3 text-right">

            <% if entry[:credit] > 0 %>

              UGX
              <%= number_with_delimiter(entry[:credit]) %>

            <% end %>

          </td>

          <td class="px-4 py-3 font-semibold text-right">

            UGX
            <%= number_with_delimiter(entry[:balance]) %>

          </td>

        </tr>

      <% end %>

      </tbody>

    </table>

  </div>

  <!-- Adjustment Summary -->

  <div class="grid grid-cols-2 gap-4 mt-8 md:grid-cols-4">

    <div class="p-4 bg-green-100 rounded">

      <p class="text-xs uppercase">

        Payment Incentives

      </p>

      <p class="mt-2 text-lg font-bold">

        UGX
        <%= number_with_delimiter(@payment_incentives) %>

      </p>

    </div>

    <div class="p-4 bg-blue-100 rounded">

      <p class="text-xs uppercase">

        Warehouse Incentives

      </p>

      <p class="mt-2 text-lg font-bold">

        UGX
        <%= number_with_delimiter(@warehouse_incentives) %>

      </p>

    </div>

    <div class="p-4 bg-purple-100 rounded">

      <p class="text-xs uppercase">

        Rebates

      </p>

      <p class="mt-2 text-lg font-bold">

        UGX
        <%= number_with_delimiter(@rebates) %>

      </p>

    </div>

    <div class="p-4 bg-gray-100 rounded">

      <p class="text-xs uppercase">

        Manual Adjustments

      </p>

      <p class="mt-2 text-lg font-bold">

        UGX
        <%= number_with_delimiter(@manual_adjustments) %>

      </p>

    </div>

  </div>

</div>