<%= render "/shared/purchases_nav" %>

<div class="px-4 pt-4 bg-white dark:bg-gray-900">

  <!-- Header -->

  <div class="grid grid-cols-2 gap-4 mb-6">

    <div>

      <h1 class="text-xl font-semibold text-gray-900 dark:text-white">
        Vendor Payments
      </h1>

      <p class="text-sm text-gray-500">
        Supplier payments made
      </p>

    </div>

    <div class="text-right">

      <%= link_to "New Payment",
          new_vendor_payment_path,
          class:"px-5 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>

    </div>

  </div>

  <!-- Filters -->

  <%= form_with url: vendor_payments_statement_path,
                method: :get,
                local: true,
                class:"flex flex-wrap items-end gap-3 mb-6" do %>

    <div>

      <label class="block mb-1 text-xs">
        Search
      </label>

      <%= text_field_tag :query,
          params[:query],
          class:"border rounded-lg p-2.5 w-64",
          placeholder:"Payment No / Ref" %>

    </div>

    <div>

      <label class="block mb-1 text-xs">
        From
      </label>

      <%= date_field_tag :start_date,
          params[:start_date],
          class:"border rounded-lg p-2.5" %>

    </div>

    <div>

      <label class="block mb-1 text-xs">
        To
      </label>

      <%= date_field_tag :end_date,
          params[:end_date],
          class:"border rounded-lg p-2.5" %>

    </div>

    <div>

      <%= submit_tag "Filter",
          class:"px-5 py-2 text-white bg-blue-600 rounded-lg" %>

    </div>

  <% end %>

  <!-- Cards -->

  <div class="grid grid-cols-1 gap-4 mb-6 md:grid-cols-3">

    <div class="p-5 bg-green-100 rounded-lg">

      <p class="text-xs uppercase">
        Total Paid
      </p>

      <p class="mt-2 text-2xl font-bold">
        UGX <%= number_with_delimiter(@total_paid) %>
      </p>

    </div>

    <div class="p-5 bg-blue-100 rounded-lg">

      <p class="text-xs uppercase">
        Payments
      </p>

      <p class="mt-2 text-2xl font-bold">
        <%= number_with_delimiter(@payment_count) %>
      </p>

    </div>

    <div class="p-5 bg-purple-100 rounded-lg">

      <p class="text-xs uppercase">
        Average Payment
      </p>

      <p class="mt-2 text-2xl font-bold">
        UGX <%= number_with_delimiter(@average_payment) %>
      </p>

    </div>

  </div>

  <!-- Table -->

  <div class="overflow-hidden bg-white rounded-lg shadow">

    <table class="min-w-full divide-y divide-gray-200">

      <thead class="bg-gray-50">

        <tr>

          <th class="px-4 py-3 text-left">Date</th>

          <th class="px-4 py-3 text-left">
            Payment No
          </th>

          <th class="px-4 py-3 text-left">
            Journal
          </th>

          <th class="px-4 py-3 text-left">
            Reference
          </th>

          <th class="px-4 py-3 text-right">
            Amount
          </th>

          <th class="px-4 py-3 text-center">
            Action
          </th>

        </tr>

      </thead>

      <tbody class="divide-y divide-gray-200">

      <% @payments.each do |payment| %>

        <tr>

          <td class="px-4 py-3">

            <%= payment.payment_date.strftime("%d %b %Y") %>

          </td>

          <td class="px-4 py-3 font-medium">

            <%= payment.payment_no %>

          </td>

          <td class="px-4 py-3">

            <%= payment.journal_no %>

          </td>

          <td class="px-4 py-3">

            <%= payment.ref_no %>

          </td>

          <td class="px-4 py-3 font-semibold text-right">

            UGX
            <%= number_with_delimiter(payment.amount) %>

          </td>

          <td class="px-4 py-3 text-center">

            <%= link_to "View",
                vendor_payment_path(payment),
                class:"text-blue-600 hover:underline" %>

          </td>

        </tr>

      <% end %>

      </tbody>

    </table>

  </div>

  <div class="mt-6">
    <%= paginate @payments %>
  </div>

</div>