<%= form_with model: [@sale, @sale_payment],
              local: true,
              data: { turbo: false },
              class: "space-y-6" do |form| %>

  <% if @sale_payment.errors.any? %>
    <div class="p-4 text-sm text-red-800 border border-red-200 rounded-lg bg-red-50">
      <p class="mb-2 font-semibold">
        Please correct the following errors:
      </p>

      <ul class="pl-5 list-disc">
        <% @sale_payment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div>
      <label class="block mb-1 text-xs font-medium text-gray-500">
        Invoice Reference
      </label>

      <input type="text"
             value="<%= @sale_payment.invoice_reference %>"
             readonly
             class="block w-full p-2.5 text-sm text-gray-700 bg-gray-100 border border-gray-300 rounded-lg">
    </div>

    <div>
      <label class="block mb-1 text-xs font-medium text-gray-500">
        Receipt Number
      </label>

      <input type="text"
             value="<%= @sale_payment.receipt_number %>"
             readonly
             class="block w-full p-2.5 text-sm text-gray-700 bg-gray-100 border border-gray-300 rounded-lg">
    </div>

    <div>
      <label class="block mb-1 text-xs font-medium text-gray-500">
        Current Invoice Balance
      </label>

      <input type="text"
             value="UGX <%= number_with_delimiter(@sale.balance) %>"
             readonly
             class="block w-full p-2.5 text-sm text-gray-700 bg-gray-100 border border-gray-300 rounded-lg">
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div>
      <%= form.label :amount,
            "Amount Received",
            class: "block mb-1 text-sm font-medium text-gray-700" %>

      <%= form.number_field :amount,
            min: 1,
            step: 1,
            required: true,
            class: "block w-full p-2.5 text-sm text-gray-900 bg-gray-50 border border-gray-300 rounded-lg" %>

      <p class="mt-1 text-xs text-gray-500">
        The customer may pay more than the current invoice balance.
      </p>
    </div>

    <div>
      <%= form.label :payment_date,
            "Payment Date",
            class: "block mb-1 text-sm font-medium text-gray-700" %>

      <%= form.date_field :payment_date,
            required: true,
            class: "block w-full p-2.5 text-sm text-gray-900 bg-gray-50 border border-gray-300 rounded-lg" %>
    </div>

    <div>
      <%= form.label :mode_of_payment,
            "Payment Method",
            class: "block mb-1 text-sm font-medium text-gray-700" %>

      <%= form.select :mode_of_payment,
            SalePayment.mode_of_payments.keys.map {
              |method| [method.humanize, method]
            },
            {},
            class: "block w-full p-2.5 text-sm text-gray-900 bg-gray-50 border border-gray-300 rounded-lg" %>
    </div>
  </div>

  <div>
    <%= form.label :notes,
          class: "block mb-1 text-sm font-medium text-gray-700" %>

    <%= form.text_area :notes,
          rows: 3,
          class: "block w-full p-2.5 text-sm text-gray-900 bg-gray-50 border border-gray-300 rounded-lg" %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel",
          sales_path,
          class: "px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg" %>

    <%= form.submit "Save Payment",
          class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg cursor-pointer hover:bg-blue-700" %>
  </div>

<% end %>