<div id="<%= dom_id sale_payment %>">
  <p>
    <strong>Sale:</strong>
    <%= sale_payment.sale_id %>
  </p>

  <p>
    <strong>Invoice reference:</strong>
    <%= sale_payment.invoice_reference %>
  </p>

  <p>
    <strong>Receipt number:</strong>
    <%= sale_payment.receipt_number %>
  </p>

  <p>
    <strong>Amount:</strong>
    <%= sale_payment.amount %>
  </p>

  <p>
    <strong>Payment date:</strong>
    <%= sale_payment.payment_date %>
  </p>

  <p>
    <strong>Mode of payment:</strong>
    <%= sale_payment.mode_of_payment %>
  </p>

  <p>
    <strong>Balance before:</strong>
    <%= sale_payment.balance_before %>
  </p>

  <p>
    <strong>Balance after:</strong>
    <%= sale_payment.balance_after %>
  </p>

  <p>
    <strong>Notes:</strong>
    <%= sale_payment.notes %>
  </p>

</div>
