
<div class="min-h-screen px-4 py-6 bg-gray-50 dark:bg-gray-900">
  <div class="mx-auto max-w-7xl">

    <% if notice.present? %>
      <div class="p-4 mb-5 text-sm text-green-800 bg-green-100 rounded-lg">
        <%= notice %>
      </div>
    <% end %>

    <!-- Header -->
    <div class="flex flex-col gap-4 mb-6 md:flex-row md:items-center md:justify-between">

      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          Payment Receipt
        </h1>

        <p class="mt-1 text-sm text-gray-500">
          <%= @sale_payment.receipt_number %>
        </p>
      </div>

      <div class="flex gap-2">

        <%= link_to "Print Receipt",
              sale_pdf_sale_path(@sale),
              class: "px-4 py-2 text-sm text-white bg-green-600 rounded-lg hover:bg-green-700" %>

        <%= link_to "Back",
              sale_payments_path,
              class: "px-4 py-2 text-sm text-gray-700 bg-white border rounded-lg hover:bg-gray-100" %>

      </div>

    </div>

    <!-- Summary -->
    <div class="grid grid-cols-1 gap-4 mb-6 md:grid-cols-4">

      <div class="p-5 bg-blue-100 rounded-lg">

        <p class="text-xs font-semibold text-blue-700 uppercase">
          Amount Received
        </p>

        <p class="mt-2 text-2xl font-bold text-blue-900">
          UGX <%= number_with_delimiter(@sale_payment.amount) %>
        </p>

      </div>

      <div class="p-5 bg-green-100 rounded-lg">

        <p class="text-xs font-semibold text-green-700 uppercase">
          Amount Allocated
        </p>

        <p class="mt-2 text-2xl font-bold text-green-900">
          UGX <%= number_with_delimiter(@sale_payment.allocated_amount) %>
        </p>

      </div>

      <div class="p-5 bg-purple-100 rounded-lg">

        <p class="text-xs font-semibold text-purple-700 uppercase">
          Customer Credit
        </p>

        <p class="mt-2 text-2xl font-bold text-purple-900">
          UGX <%= number_with_delimiter(@sale_payment.available_amount) %>
        </p>

      </div>

      <div class="p-5 bg-orange-100 rounded-lg">

        <p class="text-xs font-semibold text-orange-700 uppercase">
          Allocation Status
        </p>

        <p class="mt-2 text-xl font-bold text-orange-900">
          <%= @sale_payment.allocation_status %>
        </p>

      </div>

    </div>

    <!-- Payment Details -->
    <div class="mb-6 overflow-hidden bg-white rounded-lg shadow">

      <div class="px-5 py-3 border-b">
        <h2 class="font-semibold">
          Payment Details
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 p-5 md:grid-cols-3">

        <div>

          <p class="text-xs text-gray-500 uppercase">
            Receipt Number
          </p>

          <p class="font-semibold">
            <%= @sale_payment.receipt_number %>
          </p>

        </div>

        <div>

          <p class="text-xs text-gray-500 uppercase">
            Invoice Reference
          </p>

          <p class="font-semibold">
            <%= @sale_payment.invoice_reference %>
          </p>

        </div>

        <div>

          <p class="text-xs text-gray-500 uppercase">
            Payment Date
          </p>

          <p class="font-semibold">
            <%= @sale_payment.payment_date.strftime("%d %b %Y") %>
          </p>

        </div>

        <div>

          <p class="text-xs text-gray-500 uppercase">
            Customer
          </p>

          <p class="font-semibold">
            <%= @sale_payment.customer.name %>
          </p>

        </div>

        <div>

          <p class="text-xs text-gray-500 uppercase">
            Payment Method
          </p>

          <p class="font-semibold">
            <%= @sale_payment.mode_of_payment.humanize %>
          </p>

        </div>

        <div>

          <p class="text-xs text-gray-500 uppercase">
            Original Sale
          </p>

          <p class="font-semibold">
            <%= @sale_payment.sale&.invoice_no || "-" %>
          </p>

        </div>

      </div>

      <% if @sale_payment.notes.present? %>

        <div class="px-5 py-4 border-t">

          <p class="text-xs text-gray-500 uppercase">
            Notes
          </p>

          <p class="mt-2">
            <%= @sale_payment.notes %>
          </p>

        </div>

      <% end %>

    </div>

    <!-- Allocations -->
    <div class="overflow-hidden bg-white rounded-lg shadow">

      <div class="flex items-center justify-between px-5 py-3 border-b">

        <h2 class="font-semibold">
          Invoice Allocations
        </h2>

      </div>

      <div class="overflow-x-auto">

        <table class="min-w-full divide-y divide-gray-200">

          <thead class="bg-gray-50">

            <tr>

              <th class="px-4 py-3 text-xs text-left uppercase">
                Invoice
              </th>

              <th class="px-4 py-3 text-xs text-left uppercase">
                Sale Date
              </th>

              <th class="px-4 py-3 text-xs text-right uppercase">
                Invoice Amount
              </th>

              <th class="px-4 py-3 text-xs text-right uppercase">
                Allocated
              </th>

              <th class="px-4 py-3 text-xs text-right uppercase">
                Outstanding
              </th>

            </tr>

          </thead>

          <tbody class="divide-y divide-gray-100">

            <% @sale_payment.payment_allocations.each do |allocation| %>

              <% sale = allocation.sale %>

              <tr>

                <td class="px-4 py-3">

                  <%= link_to sale.invoice_no,
                        sale_path(sale),
                        class: "font-medium text-blue-600 hover:underline" %>

                </td>

                <td class="px-4 py-3">

                  <%= sale.sale_date.strftime("%d %b %Y") %>

                </td>

                <td class="px-4 py-3 text-right">

                  UGX <%= number_with_delimiter(sale.adjusted_invoice_amount) %>

                </td>

                <td class="px-4 py-3 font-semibold text-right text-green-700">

                  UGX <%= number_with_delimiter(allocation.amount) %>

                </td>

                <td class="px-4 py-3 font-semibold text-right <%= sale.balance.zero? ? "text-green-700" : "text-red-600" %>">

                  UGX <%= number_with_delimiter(sale.balance) %>

                </td>

              </tr>

            <% end %>

          </tbody>

        </table>

      </div>

    </div>

    <% if @sale_payment.available_amount.positive? %>

      <div class="p-5 mt-6 bg-yellow-100 rounded-lg">

        <h3 class="font-semibold text-yellow-900">
          Available Customer Credit
        </h3>

        <p class="mt-2">

          This payment still has

          <strong>

            UGX <%= number_with_delimiter(@sale_payment.available_amount) %>

          </strong>

          available.

          It will automatically be applied to the customer's next invoice.

        </p>

      </div>

    <% end %>

  </div>
</div>