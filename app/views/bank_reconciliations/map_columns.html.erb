<%= render "/shared/finance_nav" %>

<div class="max-w-5xl px-6 py-8 mx-auto">

  <h1 class="mb-6 text-3xl font-bold">
    Map Bank Statement Columns
  </h1>

  <p class="mb-8 text-gray-500">
    Tell Kabacombra which column corresponds to each accounting field.
  </p>

  <%= form_with url: save_mapping_bank_reconciliation_path(@reconciliation),
                method: :post,
                local: true do |form| %>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

      <% fields = {
        date_column: "Transaction Date",
        reference_column: "Reference",
        description_column: "Description",
        debit_column: "Debit",
        credit_column: "Credit",
        balance_column: "Balance"
      } %>

      <% fields.each do |field, label| %>

        <div>

          <%= label_tag field,
                label,
                class: "block mb-2 font-medium" %>

          <%= select_tag field,
                options_for_select(@headers),
                class: "w-full rounded-lg border-gray-300" %>

        </div>

      <% end %>

    </div>

    <div class="flex justify-end gap-3 mt-8">

      <%= link_to "Back",
            import_bank_reconciliation_path(@reconciliation),
            class: "px-5 py-2 bg-gray-200 rounded-lg" %>

      <%= submit_tag "Save Mapping",
            class: "px-6 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>

    </div>

  <% end %>

</div>