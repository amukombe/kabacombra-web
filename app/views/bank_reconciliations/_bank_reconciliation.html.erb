<div id="<%= dom_id bank_reconciliation %>">
  <p>
    <strong>Territory:</strong>
    <%= bank_reconciliation.territory_id %>
  </p>

  <p>
    <strong>User:</strong>
    <%= bank_reconciliation.user_id %>
  </p>

  <p>
    <strong>Bank account:</strong>
    <%= bank_reconciliation.bank_account_id %>
  </p>

  <p>
    <strong>Statement from:</strong>
    <%= bank_reconciliation.statement_from %>
  </p>

  <p>
    <strong>Statement to:</strong>
    <%= bank_reconciliation.statement_to %>
  </p>

  <p>
    <strong>Book balance:</strong>
    <%= bank_reconciliation.book_balance %>
  </p>

  <p>
    <strong>Bank balance:</strong>
    <%= bank_reconciliation.bank_balance %>
  </p>

  <p>
    <strong>Difference:</strong>
    <%= bank_reconciliation.difference %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= bank_reconciliation.status %>
  </p>

  <p>
    <strong>Reference:</strong>
    <%= bank_reconciliation.reference %>
  </p>

  <p>
    <strong>Reconciled at:</strong>
    <%= bank_reconciliation.reconciled_at %>
  </p>

</div>
