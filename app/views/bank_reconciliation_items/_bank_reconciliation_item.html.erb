<div id="<%= dom_id bank_reconciliation_item %>">
  <p>
    <strong>Bank reconciliation:</strong>
    <%= bank_reconciliation_item.bank_reconciliation_id %>
  </p>

  <p>
    <strong>Bank transaction:</strong>
    <%= bank_reconciliation_item.bank_transaction_id %>
  </p>

  <p>
    <strong>Bank date:</strong>
    <%= bank_reconciliation_item.bank_date %>
  </p>

  <p>
    <strong>Bank reference:</strong>
    <%= bank_reconciliation_item.bank_reference %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= bank_reconciliation_item.description %>
  </p>

  <p>
    <strong>Bank amount:</strong>
    <%= bank_reconciliation_item.bank_amount %>
  </p>

  <p>
    <strong>Matched:</strong>
    <%= bank_reconciliation_item.matched %>
  </p>

  <p>
    <strong>Cleared:</strong>
    <%= bank_reconciliation_item.cleared %>
  </p>

  <p>
    <strong>Notes:</strong>
    <%= bank_reconciliation_item.notes %>
  </p>

</div>
