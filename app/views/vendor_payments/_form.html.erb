<%= form_with model: vendor_payment,
              local: true,
              data: { turbo: false },
              class: "space-y-6" do |form| %>

  <% if vendor_payment.errors.any? %>

    <div class="p-4 border border-red-300 rounded-lg bg-red-50">

      <h2 class="mb-2 font-semibold text-red-700">
        Please correct the following errors
      </h2>

      <ul class="ml-5 text-sm text-red-600 list-disc">

        <% vendor_payment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>

      </ul>

    </div>

  <% end %>

  <!-- ===========================
       PAYMENT DETAILS
  ============================ -->

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">

    <!-- Payment Number -->

    <div>

      <label class="block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300">
        Payment Number
      </label>

      <input
        type="text"
        disabled
        value="<%= vendor_payment.payment_no.presence || 'Auto Generated' %>"
        class="w-full bg-gray-100 border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600">

    </div>

    <!-- Payment Date -->

    <div>

      <%= form.label :payment_date,
          class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.date_field :payment_date,
          class: "w-full rounded-lg border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>

    </div>

    <!-- Payment Method -->

    <div>

      <%= form.label :payment_method,
          class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.select :payment_method,
          VendorPayment.payment_methods.keys.map { |m| [m.titleize, m] },
          {},
          class: "w-full rounded-lg border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>

    </div>

    <!-- Amount -->

    <div>

      <%= form.label :amount,
          class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.number_field :amount,
          step: 0.01,
          min: 0,
          class: "w-full rounded-lg border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>

    </div>

    <!-- Suspense Amount -->

    <div>

      <%= form.label :suspense_amount,
          class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.number_field :suspense_amount,
          step: 0.01,
          min: 0,
          class: "w-full rounded-lg border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>

    </div>

    <!-- Reference -->

    <div>

      <%= form.label :ref_no,
          "Reference Number",
          class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.text_field :ref_no,
          class: "w-full rounded-lg border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>

    </div>

    <!-- Journal -->

    <div>

      <%= form.label :journal_no,
          class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.text_field :journal_no,
          class: "w-full rounded-lg border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>

    </div>

  </div>

  <!-- ===========================
       NOTES
  ============================ -->

  <div>

    <%= form.label :notes,
        class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

    <%= form.text_area :notes,
        rows: 5,
        placeholder: "Additional notes...",
        class: "w-full rounded-lg border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>

  </div>

  <!-- ===========================
       SUMMARY
  ============================ -->

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

    <div class="p-4 text-blue-800 bg-blue-100 rounded-lg">

      <p class="text-xs font-semibold uppercase">
        Payment Amount
      </p>

      <p class="mt-2 text-2xl font-bold">

        UGX
        <span id="payment-preview">0</span>

      </p>

    </div>

    <div class="p-4 text-yellow-800 bg-yellow-100 rounded-lg">

      <p class="text-xs font-semibold uppercase">
        Suspense Amount
      </p>

      <p class="mt-2 text-2xl font-bold">

        UGX
        <span id="suspense-preview">0</span>

      </p>

    </div>

    <div class="p-4 text-green-800 bg-green-100 rounded-lg">

      <p class="text-xs font-semibold uppercase">
        Total Cash Out
      </p>

      <p class="mt-2 text-2xl font-bold">

        UGX
        <span id="total-preview">0</span>

      </p>

    </div>

  </div>

  <!-- ===========================
       ACTIONS
  ============================ -->

  <div class="flex justify-end gap-3 pt-2 border-t">

    <%= link_to "Cancel",
        vendor_payments_path,
        class: "px-5 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300" %>

    <%= form.submit "Save Payment",
        class: "px-6 py-2 font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>

  </div>

<% end %>