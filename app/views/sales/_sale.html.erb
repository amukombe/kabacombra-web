
<div class="min-h-screen px-4 py-6 bg-gray-50 dark:bg-gray-900">
  <div class="mx-auto max-w-screen-2xl">

    <% if notice.present? %>
      <div class="p-4 mb-5 text-sm text-green-800 border border-green-200 rounded-lg bg-green-50 dark:bg-green-900/20 dark:text-green-300 dark:border-green-800">
        <%= notice %>
      </div>
    <% end %>

    <!-- Header -->
    <div class="flex flex-col gap-4 mb-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-xl font-semibold text-gray-900 dark:text-white">
          Sale Invoice
        </h1>

        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          <%= @sale.invoice_no.presence || @sale.receipt_no %>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <% if @sale.balance.to_d.positive? %>
          <%= link_to "Add Payment",
                new_sale_sale_payment_path(@sale),
                data: { turbo: false },
                class: "px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700" %>
        <% end %>

        <%= link_to "Credit Note",
              new_sale_customer_adjustment_path(
                @sale,
                adjustment_type: "credit_note"
              ),
              data: { turbo: false },
              class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700" %>

        <%= link_to "Debit Note",
              new_sale_customer_adjustment_path(
                @sale,
                adjustment_type: "debit_note"
              ),
              data: { turbo: false },
              class: "px-4 py-2 text-sm font-medium text-white bg-orange-600 rounded-lg hover:bg-orange-700" %>

        <%= link_to "Print Invoice",
              sale_pdf_sale_path(@sale, format: :pdf),
              target: "_blank",
              class: "px-4 py-2 text-sm font-medium text-white bg-gray-700 rounded-lg hover:bg-gray-800" %>

        <%= link_to "Back to Sales",
              sales_path,
              class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600" %>
      </div>
    </div>

    <!-- Financial Summary -->
    <div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2 xl:grid-cols-5">

      <div class="p-4 text-blue-800 border border-blue-200 rounded-lg bg-blue-50 dark:bg-blue-900/20 dark:border-blue-800 dark:text-blue-300">
        <p class="text-xs font-medium uppercase">Original Invoice</p>

        <p class="mt-2 text-xl font-bold">
          UGX <%= number_with_delimiter(@sale.total_price.to_d) %>
        </p>
      </div>

      <div class="p-4 text-orange-800 border border-orange-200 rounded-lg bg-orange-50 dark:bg-orange-900/20 dark:border-orange-800 dark:text-orange-300">
        <p class="text-xs font-medium uppercase">Debit Notes</p>

        <p class="mt-2 text-xl font-bold">
          UGX <%= number_with_delimiter(@sale.debited_amount.to_d) %>
        </p>
      </div>

      <div class="p-4 text-purple-800 border border-purple-200 rounded-lg bg-purple-50 dark:bg-purple-900/20 dark:border-purple-800 dark:text-purple-300">
        <p class="text-xs font-medium uppercase">Credit Notes</p>

        <p class="mt-2 text-xl font-bold">
          UGX <%= number_with_delimiter(@sale.credited_amount.to_d) %>
        </p>
      </div>

      <div class="p-4 text-green-800 border border-green-200 rounded-lg bg-green-50 dark:bg-green-900/20 dark:border-green-800 dark:text-green-300">
        <p class="text-xs font-medium uppercase">Total Paid</p>

        <p class="mt-2 text-xl font-bold">
          UGX <%= number_with_delimiter(@sale.paid_amount.to_d) %>
        </p>
      </div>

      <div class="p-4 border rounded-lg <%= @sale.balance.to_d.positive? ? 'text-red-800 bg-red-50 border-red-200 dark:bg-red-900/20 dark:border-red-800 dark:text-red-300' : 'text-green-800 bg-green-50 border-green-200 dark:bg-green-900/20 dark:border-green-800 dark:text-green-300' %>">
        <p class="text-xs font-medium uppercase">Outstanding Balance</p>

        <p class="mt-2 text-xl font-bold">
          UGX <%= number_with_delimiter([@sale.balance.to_d, 0].max) %>
        </p>
      </div>

    </div>

    <!-- Sale and Customer Information -->
    <div class="grid grid-cols-1 gap-6 mb-6 lg:grid-cols-2">

      <!-- Sale Details -->
      <div class="p-5 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <h2 class="pb-3 mb-4 text-base font-semibold text-gray-900 border-b border-gray-200 dark:text-white dark:border-gray-700">
          Sale Details
        </h2>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Invoice Number
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.invoice_no.presence || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Receipt Number
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.receipt_no.presence || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Sale Date
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.sale_date&.strftime("%d %b, %Y %I:%M %p") %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Sale Type
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.mode_of_payment&.humanize %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Sales Route
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.sales_route.presence || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Store
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.store&.name || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              FDN
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.fdn.presence || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Status
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.status&.name || "-" %>
            </p>
          </div>
        </div>

        <% if @sale.notes.present? %>
          <div class="pt-4 mt-5 border-t border-gray-200 dark:border-gray-700">
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Notes
            </p>

            <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">
              <%= @sale.notes %>
            </p>
          </div>
        <% end %>
      </div>

      <!-- Customer Details -->
      <div class="p-5 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <h2 class="pb-3 mb-4 text-base font-semibold text-gray-900 border-b border-gray-200 dark:text-white dark:border-gray-700">
          Customer Details
        </h2>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Customer
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.customer&.name || @sale.customer_name || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Mobile
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.customer&.mobile || @sale.customer_mobile || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              BRN / NIN / TIN
            </p>

            <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">
              <%= @sale.customer&.brn || @sale.tin || "-" %>
            </p>
          </div>

          <div>
            <p class="text-xs font-medium text-gray-500 uppercase dark:text-gray-400">
              Available Customer Credit
            </p>

            <p class="mt-1 text-sm font-bold text-purple-600 dark:text-purple-400">
              UGX <%= number_with_delimiter(@sale.customer&.available_credit.to_d) %>
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Sale Items -->
    <div class="mb-6 overflow-hidden bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
      <div class="p-5 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">
          Sale Items
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-4 py-3 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-300">
                Product
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Quantity
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Unit Price
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Discount
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Total
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <% @sale.sale_items.each do |item| %>
              <tr>
                <td class="px-4 py-4 text-sm text-gray-900 dark:text-white">
                  <div class="flex flex-col">
                    <span class="font-medium">
                      <%= item.nile_product&.name %>
                    </span>

                    <% if item.purchase_type.present? %>
                      <span class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                        <%= item.purchase_type.name %>
                      </span>
                    <% end %>
                  </div>
                </td>

                <td class="px-4 py-4 text-sm text-right text-gray-700 dark:text-gray-300">
                  <%= number_with_delimiter(item.quantity_sold) %>
                </td>

                <td class="px-4 py-4 text-sm text-right text-gray-700 dark:text-gray-300">
                  UGX <%= number_with_delimiter(item.amount) %>
                </td>

                <td class="px-4 py-4 text-sm text-right text-gray-700 dark:text-gray-300">
                  UGX <%= number_with_delimiter(item.discount_total.to_d) %>
                </td>

                <td class="px-4 py-4 text-sm font-semibold text-right text-gray-900 dark:text-white">
                  UGX <%= number_with_delimiter(item.total.to_d) %>
                </td>
              </tr>
            <% end %>
          </tbody>

          <tfoot class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <td colspan="4"
                  class="px-4 py-4 text-base font-bold text-right text-gray-900 dark:text-white">
                Original Invoice Total
              </td>

              <td class="px-4 py-4 text-lg font-bold text-right text-gray-900 dark:text-white">
                UGX <%= number_with_delimiter(@sale.total_price.to_d) %>
              </td>
            </tr>

            <tr>
              <td colspan="4"
                  class="px-4 py-3 text-sm font-semibold text-right text-gray-700 dark:text-gray-300">
                Debit Notes
              </td>

              <td class="px-4 py-3 text-sm font-semibold text-right text-orange-600">
                + UGX <%= number_with_delimiter(@sale.debited_amount.to_d) %>
              </td>
            </tr>

            <tr>
              <td colspan="4"
                  class="px-4 py-3 text-sm font-semibold text-right text-gray-700 dark:text-gray-300">
                Credit Notes
              </td>

              <td class="px-4 py-3 text-sm font-semibold text-right text-purple-600">
                - UGX <%= number_with_delimiter(@sale.credited_amount.to_d) %>
              </td>
            </tr>

            <tr>
              <td colspan="4"
                  class="px-4 py-4 text-base font-bold text-right text-gray-900 dark:text-white">
                Adjusted Invoice Amount
              </td>

              <td class="px-4 py-4 text-lg font-bold text-right text-blue-700 dark:text-blue-300">
                UGX <%= number_with_delimiter(@sale.adjusted_invoice_amount.to_d) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Payment Allocations -->
    <div class="mb-6 overflow-hidden bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
      <div class="flex items-center justify-between p-5 border-b border-gray-200 dark:border-gray-700">
        <div>
          <h2 class="text-base font-semibold text-gray-900 dark:text-white">
            Payments Applied
          </h2>

          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Receipts allocated to this invoice.
          </p>
        </div>

        <% if @sale.balance.to_d.positive? %>
          <%= link_to "Add Payment",
                new_sale_sale_payment_path(@sale),
                data: { turbo: false },
                class: "px-3 py-2 text-xs font-medium text-white bg-green-600 rounded-lg hover:bg-green-700" %>
        <% end %>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-4 py-3 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-300">
                Receipt
              </th>

              <th class="px-4 py-3 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-300">
                Payment Date
              </th>

              <th class="px-4 py-3 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-300">
                Method
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Receipt Amount
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Applied Here
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Action
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <% if @sale.payment_allocations.any? %>
              <% @sale.payment_allocations.each do |allocation| %>
                <% payment = allocation.sale_payment %>

                <tr>
                  <td class="px-4 py-4 text-sm font-semibold text-gray-900 dark:text-white">
                    <%= payment.receipt_number %>
                  </td>

                  <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300">
                    <%= payment.payment_date&.strftime("%d %b, %Y") %>
                  </td>

                  <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300">
                    <%= payment.mode_of_payment&.humanize %>
                  </td>

                  <td class="px-4 py-4 text-sm text-right text-gray-700 dark:text-gray-300">
                    UGX <%= number_with_delimiter(payment.amount.to_d) %>
                  </td>

                  <td class="px-4 py-4 text-sm font-semibold text-right text-green-600">
                    UGX <%= number_with_delimiter(allocation.amount.to_d) %>
                  </td>

                  <td class="px-4 py-4 text-sm text-right">
                    <%= link_to "View Receipt",
                          sale_sale_payment_path(
                            payment.sale || @sale,
                            payment
                          ),
                          data: { turbo: false },
                          class: "text-xs font-medium text-blue-600 hover:underline" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6"
                    class="px-4 py-10 text-sm text-center text-gray-500 dark:text-gray-400">
                  No payment has been applied to this invoice.
                </td>
              </tr>
            <% end %>
          </tbody>

          <tfoot class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <td colspan="4"
                  class="px-4 py-4 text-sm font-bold text-right text-gray-900 dark:text-white">
                Total Paid
              </td>

              <td class="px-4 py-4 text-base font-bold text-right text-green-600">
                UGX <%= number_with_delimiter(@sale.paid_amount.to_d) %>
              </td>

              <td></td>
            </tr>

            <tr>
              <td colspan="4"
                  class="px-4 py-4 text-sm font-bold text-right text-gray-900 dark:text-white">
                Outstanding Balance
              </td>

              <td class="px-4 py-4 text-base font-bold text-right <%= @sale.balance.to_d.positive? ? 'text-red-600' : 'text-green-600' %>">
                UGX <%= number_with_delimiter([@sale.balance.to_d, 0].max) %>
              </td>

              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Adjustments -->
    <div class="overflow-hidden bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
      <div class="p-5 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">
          Credit and Debit Notes
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-4 py-3 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-300">
                Document
              </th>

              <th class="px-4 py-3 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-300">
                Type
              </th>

              <th class="px-4 py-3 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-300">
                Date
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Amount
              </th>

              <th class="px-4 py-3 text-xs font-medium text-center text-gray-500 uppercase dark:text-gray-300">
                Status
              </th>

              <th class="px-4 py-3 text-xs font-medium text-right text-gray-500 uppercase dark:text-gray-300">
                Action
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <% if @sale.customer_adjustments.any? %>
              <% @sale.customer_adjustments.order(adjustment_date: :desc, id: :desc).each do |adjustment| %>
                <tr>
                  <td class="px-4 py-4 text-sm font-semibold text-gray-900 dark:text-white">
                    <%= adjustment.adjustment_number %>
                  </td>

                  <td class="px-4 py-4 text-sm">
                    <span class="<%= adjustment.credit_note? ? 'text-purple-600' : 'text-orange-600' %>">
                      <%= adjustment.adjustment_type.humanize %>
                    </span>
                  </td>

                  <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300">
                    <%= adjustment.adjustment_date&.strftime("%d %b, %Y") %>
                  </td>

                  <td class="px-4 py-4 text-sm font-semibold text-right <%= adjustment.credit_note? ? 'text-purple-600' : 'text-orange-600' %>">
                    <%= adjustment.credit_note? ? "-" : "+" %>
                    UGX <%= number_with_delimiter(adjustment.total_amount.to_d) %>
                  </td>

                  <td class="px-4 py-4 text-center">
                    <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full
                      <%= case adjustment.status
                          when 'approved'
                            'text-green-700 bg-green-100'
                          when 'cancelled'
                            'text-red-700 bg-red-100'
                          else
                            'text-yellow-700 bg-yellow-100'
                          end %>">
                      <%= adjustment.status.humanize %>
                    </span>
                  </td>

                  <td class="px-4 py-4 text-sm text-right">
                    <%= link_to "View",
                          customer_adjustment_path(adjustment),
                          data: { turbo: false },
                          class: "text-xs font-medium text-blue-600 hover:underline" %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6"
                    class="px-4 py-10 text-sm text-center text-gray-500 dark:text-gray-400">
                  No credit or debit notes have been created for this invoice.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>