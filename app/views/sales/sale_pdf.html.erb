<div class="rounded-lg shadow-lg dark:bg-gray-800">
    <div class="p-4 pb-4 mb-4 d-flex justify-content-between align-items-start border-bottom">

    <!-- Company Logo -->
    <div>
        <%= wicked_pdf_image_tag 'logo.png', style: "height:200px;" %>
    </div>

    <!-- Invoice Details -->
    <div class="text-end" style="width:70%;">

        <h1 class="mb-3 display-5 fw-bold title-color">
            <%= @sale.credit? ? "INVOICE" : "SALES RECEIPT" %>
        </h1>

        <table class="table w-auto table-borderless table-sm ms-auto">

            <tr>
                <th class="text-end pe-3">Invoice No:</th>
                <td><%= @sale.invoice_no %></td>
            </tr>

            <tr>
                <th class="text-end pe-3">Receipt No:</th>
                <td>
                    <%= @sale.receipt_no.present? ? @sale.receipt_no : "Pending Payment" %>
                </td>
            </tr>

            <tr>
                <th class="text-end pe-3">Invoice Date:</th>
                <td><%= @sale.sale_date.strftime("%d %b %Y") %></td>
            </tr>

            <tr>
                <th class="text-end pe-3">Time:</th>
                <td><%= @sale.sale_date.strftime("%I:%M %p") %></td>
            </tr>

        </table>

    </div>

</div>

    <div class="px-4">
        <div class="d-flex justify-content-between">
            <div class="text-sm text-gray-600 dark:text-gray-400">
                <p><span class="font-semibold">Name:</span> <%= @sale.customer.name %></p>
                <p><span class="font-semibold">BRN/NIN:</span> <%= @sale.customer.brn %></p>
                <p><span class="font-semibold">Address:</span> <%= @sale.customer.location %></p>
                <p><span class="font-semibold">Mobile:</span> <%= @sale.customer.mobile %></p>
                <p><span class="font-semibold">Payment Details:</span> <%= @sale.payment_ref %></p>
                
            </div>
        </div>
    </div>
    <div class="p-4">
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th class="text-sm text-gray-600 dark:text-gray-400">#</th>
                    <th class="text-sm text-gray-600 dark:text-gray-400">Item</th>
                    <th class="text-sm text-gray-600 dark:text-gray-400">Quantity</th>
                    <th class="text-sm text-gray-600 dark:text-gray-400">Unit Price</th>
                    <th class="text-sm text-gray-600 dark:text-gray-400">Discount</th>
                    <th class="text-sm text-gray-600 dark:text-gray-400">Total</th>
                </tr>
            </thead>
            <tbody>
                <% @sale.sale_items.each_with_index do |item, index| %>
                    <tr>
                        <td class="text-sm text-gray-900 dark:text-white"><%= index + 1 %></td>
                        <td class="text-sm text-gray-900 dark:text-white"><%= item.nile_product.name %></td>
                        <td class="text-sm text-gray-900 dark:text-white"><%= number_with_delimiter(item.quantity_sold) %> Bags</td>
                        <td class="text-sm text-gray-900 dark:text-white"><%= number_with_delimiter(item.amount) %></td>
                        <td class="text-sm text-gray-900 dark:text-white"><%= number_with_delimiter(item.discount_total) %></td>
                        <td class="text-sm text-gray-900 dark:text-white"><%= number_with_delimiter(item.total) %></td>
                    </tr>
                <% end %>
            </tbody>
            <tfoot>
                <% 
                sub_total = (@sale.total_price / 1.18).round
                vat = (@sale.total_price - sub_total).round
                %>

                <tr class="table-light">
                    <th colspan="5" class="text-sm text-gray-600 text-end dark:text-gray-400">
                        Sub Total
                    </th>
                    <th class="text-sm text-gray-900 dark:text-white">
                        <%= number_with_delimiter(sub_total) %>
                    </th>
                </tr>

                <tr class="table-light">
                    <th colspan="5" class="text-sm text-gray-600 text-end dark:text-gray-400">
                        VAT (18%)
                    </th>
                    <th class="text-sm text-gray-900 dark:text-white">
                        <%= number_with_delimiter(vat) %>
                    </th>
                </tr>

                <tr class="table-light">
                    <th colspan="5" class="text-sm text-gray-600 text-end dark:text-gray-400">
                        Grand Total
                    </th>
                    <th class="text-sm text-gray-900 dark:text-white">
                        <%= number_with_delimiter(@sale.total_price.round) %>
                    </th>
                </tr>
            </tfoot>
        </table>
    </div>


    <div class="p-4 row">
        <div class="col-4">
            
            <span class="px-4 text-sm text-gray-600 dark:text-gray-400">Notes</span>
            <p class="px-4 text-sm text-gray-900 dark:text-white"><%= @sale.notes %></p>
        </div>
    </div>
    <div class="px-4">
        <div class="d-flex justify-content-between">
            
            <div class="text-sm text-gray-600 dark:text-gray-400">
                <p><span class="font-semibold">Store:</span> <%= @sale.store.name %></p>
                <p><span class="font-semibold">Territory:</span> <%= @sale.territory.name %></p>
                <p><span class="font-semibold">Served By:</span> <%= @sale.user.employee.fullname %></p>
            </div>
        </div>
    </div>
</div>