<%= render "/shared/finance_nav" %>

<div class="min-h-screen px-4 py-4 bg-gray-50 dark:bg-gray-900">

  <!-- ========================================================= -->
  <!-- Header -->
  <!-- ========================================================= -->

  <div class="flex items-center justify-between mb-6">

    <div>

      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
        Bank Transactions
      </h1>

      <p class="mt-1 text-gray-500">
        Banking ledger for all bank accounts
      </p>

    </div>

    <div class="flex gap-2">

      <%= link_to "Export PDF",
          export_pdf_bank_transactions_path(request.query_parameters),
          class: "px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700" %>

      <%= link_to "Export Excel",
          export_excel_bank_transactions_path(request.query_parameters),
          class: "px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700" %>

    </div>

  </div>

  <!-- ========================================================= -->
  <!-- Filters -->
  <!-- ========================================================= -->

  <%= form_with url: bank_transactions_path,
                method: :get,
                local: true,
                class: "grid grid-cols-1 md:grid-cols-5 gap-4 mb-8" do %>

      <div>

        <label class="block mb-1 text-xs font-semibold">
          Search
        </label>

        <%= text_field_tag :query,
              params[:query],
              placeholder: "Reference, cheque...",
              class: "w-full rounded-lg border-gray-300" %>

      </div>

      <div>

        <label class="block mb-1 text-xs font-semibold">
          Account
        </label>

        <%= select_tag :bank_account_id,

              options_from_collection_for_select(
                @accounts,
                :id,
                :account_name,
                params[:bank_account_id]
              ),

              include_blank: "All Accounts",

              class: "w-full rounded-lg border-gray-300" %>

      </div>

      <div>

        <label class="block mb-1 text-xs font-semibold">
          Transaction Type
        </label>

        <%= select_tag :transaction_type,

              options_for_select(

                BankTransaction
                  .distinct
                  .pluck(:transaction_type),

                params[:transaction_type]

              ),

              include_blank: "All",

              class: "w-full rounded-lg border-gray-300" %>

      </div>

      <div>

        <label class="block mb-1 text-xs font-semibold">
          From
        </label>

        <%= date_field_tag :start_date,
              params[:start_date],
              class: "w-full rounded-lg border-gray-300" %>

      </div>

      <div>

        <label class="block mb-1 text-xs font-semibold">
          To
        </label>

        <%= date_field_tag :end_date,
              params[:end_date],
              class: "w-full rounded-lg border-gray-300" %>

      </div>

      <div class="md:col-span-5">

        <%= submit_tag "Apply Filters",
              class: "px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>

      </div>

  <% end %>

  <!-- ========================================================= -->
  <!-- Summary -->
  <!-- ========================================================= -->

  <div class="grid grid-cols-1 gap-4 mb-8 md:grid-cols-4">

    <div class="p-5 bg-white shadow rounded-xl">

      <p class="text-xs text-gray-500 uppercase">

        Transactions

      </p>

      <p class="mt-2 text-2xl font-bold">

        <%= @total_transactions %>

      </p>

    </div>

    <div class="p-5 shadow bg-green-50 rounded-xl">

      <p class="text-xs text-green-700 uppercase">

        Total Deposits

      </p>

      <p class="mt-2 text-2xl font-bold text-green-700">

        UGX
        <%= number_with_delimiter(@total_debits) %>

      </p>

    </div>

    <div class="p-5 shadow bg-red-50 rounded-xl">

      <p class="text-xs text-red-700 uppercase">

        Total Withdrawals

      </p>

      <p class="mt-2 text-2xl font-bold text-red-700">

        UGX
        <%= number_with_delimiter(@total_credits) %>

      </p>

    </div>

    <div class="p-5 shadow bg-blue-50 rounded-xl">

      <p class="text-xs text-blue-700 uppercase">

        Net Cash Flow

      </p>

      <p class="mt-2 text-2xl font-bold text-blue-700">

        UGX
        <%= number_with_delimiter(@net_cashflow) %>

      </p>

    </div>

  </div>

  <!-- ========================================================= -->
  <!-- Ledger -->
  <!-- ========================================================= -->

  <div class="overflow-hidden bg-white shadow rounded-xl">

    <table class="min-w-full divide-y divide-gray-200">

      <thead class="bg-gray-100">

        <tr>

          <th class="px-4 py-3 text-left">Date</th>

          <th class="px-4 py-3 text-left">Account</th>

          <th class="px-4 py-3 text-left">Reference</th>

          <th class="px-4 py-3 text-left">Transaction</th>

          <th class="px-4 py-3 text-center">Method</th>

          <th class="px-4 py-3 text-right">Amount</th>

          <th class="px-4 py-3 text-center"></th>

        </tr>

      </thead>

      <tbody class="divide-y divide-gray-200">

      <% @transactions.each do |transaction| %>

        <tr class="hover:bg-gray-50">

          <td class="px-4 py-3">

            <%= transaction.cleared_date.strftime("%d %b %Y") %>

          </td>

          <td class="px-4 py-3">

            <strong>

              <%= transaction.bank_account.account_name %>

            </strong>

          </td>

          <td class="px-4 py-3">

            <%= transaction.financial_transaction&.reference ||
                transaction.cheque_number ||
                "-" %>

          </td>

          <td class="px-4 py-3">

            <%= transaction.transaction_type.to_s.titleize %>

          </td>

          <td class="px-4 py-3 text-center">

            <% if transaction.method == "deposit" %>

              <span class="px-2 py-1 text-xs text-green-700 bg-green-100 rounded-full">

                Deposit

              </span>

            <% else %>

              <span class="px-2 py-1 text-xs text-red-700 bg-red-100 rounded-full">

                Withdraw

              </span>

            <% end %>

          </td>

          <td class="px-4 py-3 font-semibold text-right">

            <% if transaction.method == "deposit" %>

              <span class="text-green-700">

                UGX
                <%= number_with_delimiter(transaction.amount) %>

              </span>

            <% else %>

              <span class="text-red-700">

                UGX
                <%= number_with_delimiter(transaction.amount) %>

              </span>

            <% end %>

          </td>

          <td class="px-4 py-3 text-center">

            <%= link_to "View",

                  bank_transaction_path(transaction),

                  class: "text-blue-600 hover:text-blue-800 font-medium" %>

          </td>

        </tr>

      <% end %>

      </tbody>

    </table>

  </div>

  <!-- ========================================================= -->
  <!-- Pagination -->
  <!-- ========================================================= -->

  <div class="mt-6">

    <%== pagy_nav(@pagy) if defined?(@pagy) %>

  </div>

</div>