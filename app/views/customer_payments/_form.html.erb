<%= form_with model: customer_payment, local: true do |form| %>

  <% if customer_payment.errors.any? %>

    <div class="p-4 mb-6 text-red-700 bg-red-50 border border-red-200 rounded-lg">

      <div class="font-semibold">
        <%= pluralize(customer_payment.errors.count, "error") %>
        prevented this payment from being saved:
      </div>

      <ul class="mt-2 ml-5 list-disc">

        <% customer_payment.errors.full_messages.each do |message| %>
          <li>
            <%= message %>
          </li>
        <% end %>

      </ul>

    </div>

  <% end %>


  <!-- ===================================================== -->
  <!-- Payment Information -->
  <!-- ===================================================== -->

  <div class="p-6 bg-white border border-gray-200 shadow-sm rounded-xl dark:bg-gray-800 dark:border-gray-700">


    <!-- =================================================== -->
    <!-- Header -->
    <!-- =================================================== -->

    <div class="pb-5 mb-6 border-b border-gray-200 dark:border-gray-700">

      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">
        Payment Information
      </h2>

      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Enter the payment received from the customer.
      </p>

    </div>


    <!-- =================================================== -->
    <!-- Row 1 -->
    <!-- Customer / Mobile / BRN-NIN -->
    <!-- =================================================== -->

    <div
      class="grid grid-cols-1 gap-6 md:grid-cols-3" data-controller="customer-autocomplete">


      <!-- ================================================ -->
      <!-- Customer -->
      <!-- ================================================ -->

      <div>
      <%= form.hidden_field :customer_id, data: {customer_autocomplete_target: "customerId" } %>
      <%= form.label :customer, class:"text-sm text-gray-600 dark:text-gray-400" %>
      <div class="relative">
        <%= form.text_field :customer_name,
            data: {
              customer_autocomplete_target: "name",
              action: "keyup->customer-autocomplete#search"
            },
            class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5" %>

        <div
          data-customer-autocomplete-target="results"
          class="absolute z-50 w-full bg-white border rounded shadow-lg">
        </div>
      </div>
    </div>
    <div>
      <%= form.label :customer_mobile, class:"text-sm text-gray-600 dark:text-gray-400" %>
      <%= form.text_field :customer_mobile, data: { customer_autocomplete_target: "mobile" }, class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" %>
    </div>
    <div>
      <%= form.label :customer_tin, "BRN / NIN", class:"text-sm text-gray-600 dark:text-gray-400" %>
      <%= form.text_field :tin, data: { customer_autocomplete_target: "tin" }, class:"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" %>
    </div>

    </div>


    <!-- =================================================== -->
    <!-- Row 2 -->
    <!-- Payment Number / Payment Date / Amount -->
    <!-- =================================================== -->

    <div class="grid grid-cols-1 gap-6 mt-6 md:grid-cols-3">


      <!-- ================================================ -->
      <!-- Payment Number -->
      <!-- ================================================ -->

      <div>

        <%= form.label :payment_no,
            "Payment Number",
            class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

        <%= form.text_field :payment_no,
            placeholder: "CP-000001",
            class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" %>

      </div>


      <!-- ================================================ -->
      <!-- Payment Date -->
      <!-- ================================================ -->

      <div>

        <%= form.label :payment_date,
            "Payment Date",
            class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

        <%= form.date_field :payment_date,
            class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" %>

      </div>


      <!-- ================================================ -->
      <!-- Amount -->
      <!-- ================================================ -->

      <div>

        <%= form.label :amount,
            "Amount Received",
            class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

        <%= form.number_field :amount,
            step: "0.01",
            min: "0",
            placeholder: "0",
            class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" %>

      </div>

    </div>


    <!-- =================================================== -->
    <!-- Row 3 -->
    <!-- Payment Method / Payment Reference / Empty -->
    <!-- =================================================== -->

    <div class="grid grid-cols-1 gap-6 mt-6 md:grid-cols-3">


      <!-- ================================================ -->
      <!-- Payment Method -->
      <!-- ================================================ -->

      <div>

        <%= form.label :payment_method,
            "Payment Method",
            class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

        <%= form.select(
              :payment_method,

              CustomerPayment.payment_methods.keys.map do |method|

                [
                  method.titleize,
                  method
                ]

              end,

              {
                prompt: "Select payment method"
              },

              {
                class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
              }

            ) %>

      </div>


      <!-- ================================================ -->
      <!-- Payment Reference -->
      <!-- ================================================ -->

      <div>

        <%= form.label :payment_ref,
            "Payment Reference",
            class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

        <%= form.text_field :payment_ref,
            placeholder: "Bank / Mobile Money / Cheque reference",
            class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" %>

      </div>


      <!-- ================================================ -->
      <!-- Empty Column -->
      <!-- ================================================ -->

      <div></div>

    </div>


    <!-- =================================================== -->
    <!-- Row 4 -->
    <!-- Notes -->
    <!-- =================================================== -->

    <div class="mt-6">

      <%= form.label :notes,
          "Notes",
          class: "block mb-2 text-sm font-medium text-gray-700 dark:text-gray-300" %>

      <%= form.text_area :notes,
          rows: 3,
          placeholder: "Additional information about this payment...",
          class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5 focus:ring-primary-600 focus:border-primary-600 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white" %>

    </div>


    <!-- =================================================== -->
    <!-- Allocation Information -->
    <!-- =================================================== -->

    <div class="p-4 mt-6 text-sm text-blue-800 bg-blue-50 border border-blue-200 rounded-lg dark:bg-blue-900 dark:text-blue-100 dark:border-blue-800">

      <div class="flex gap-3">

        <svg
          class="flex-shrink-0 w-5 h-5 mt-0.5"
          fill="currentColor"
          viewBox="0 0 20 20">

          <path
            fill-rule="evenodd"
            d="M18 10A8 8 0 1 1 2 10a8 8 0 0 1 16 0ZM9 9a1 1 0 1 1 2 0v4a1 1 0 1 1-2 0V9Zm1-4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z"
            clip-rule="evenodd" />

        </svg>

        <div>

          <p class="font-semibold">
            Payment Allocation
          </p>

          <p class="mt-1">
            This payment can be allocated against the customer's
            outstanding invoices.
          </p>

          <p class="mt-1">
            If the payment is greater than the outstanding invoices,
            the remaining amount will remain as customer credit and
            can be applied to future invoices.
          </p>

        </div>

      </div>

    </div>


    <!-- =================================================== -->
    <!-- Actions -->
    <!-- =================================================== -->

    <div class="flex justify-end gap-3 mt-8">

      <%= link_to "Cancel",
          sale_payments_path,
          class: "px-5 py-2 text-sm font-medium text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" %>


      <%= form.submit(
            customer_payment.persisted? ? "Update Payment" : "Continue",
            class: "px-6 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 focus:ring-4 focus:ring-green-200"
          ) %>

    </div>

  </div>

<% end %>